{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    },
    {
      "pattern": "^(https:\\/\\/)?([www.]?)+(microsoft.com\\/)+[\\w\\-\\._~:/?#[\\]@!\\$&'\\(\\)\\*\\+,;=.]+$"
    },
    {
      "pattern": "img/"
    },
    {
      "pattern": "/shortcodes/code/"
    },
    {
      "pattern": "^(?:\\.\\.?/)+(?:spec|plan|research|data-model|quickstart|checklists/requirements|\\.specify/memory/constitution)\\.md$"
    },
    {
      "pattern": "docs/themes/hugo-theme-relearn"
    },
    {
      "pattern": "^https://drone.thegeeklab.de"
    },
    {
      "pattern": "^https://github\\.com/microsoft/mcr/blob/main/teams/bicep/bicep\\.yml$"
    },
    {
      "pattern": "^https://aka.ms/opensource/security/"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "\\{\\{%\\s*siteparam\\s+base\\s*%\\}\\}",
      "replacement": "https://azure.github.io/Azure-Verified-Modules"
    },
    {
      "pattern": "\\{\\{%\\s*siteparam\\s+baseURL\\s*%\\}\\}",
      "replacement": "https://github.com/Azure/Azure-Verified-Modules/"
    },
    {
      "pattern": "^/",
      "replacement": "https://azure.github.io/"
    }
  ],
  "httpHeaders": [
    {
      "comment": "Workaround as suggested here: https://github.com/tcort/markdown-link-check/issues/201",
      "urls": [
        "https://docs.github.com/"
      ],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [
    200,
    203,
    206
  ]
}
